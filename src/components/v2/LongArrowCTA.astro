---
interface Props {
  href: string;
  label: string;
  delay?: string;
}
const { href, label, delay = '0s' } = Astro.props;
---

<!-- Wrapper: entrance opacity 0→1. Link: hover states work independently. -->
<div class="lca-wrap" style={`animation-delay: ${delay};`}>
  <a href={href} class="lca">
    <span class="lca-label">{label}</span>
    <span class="lca-arrow" aria-hidden="true">———→</span>
  </a>
</div>

<style>
  .lca-wrap {
    opacity: 0;
    animation: lcaWrapIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .lca {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-primary);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--proma-cream-100);
    opacity: 0.40;
    transition:
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      color   0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lca:hover {
    opacity: 1;
    color: var(--proma-terra-500);
  }

  .lca-arrow {
    display: inline-block;
    letter-spacing: -0.02em;
    transition:
      transform      0.4s cubic-bezier(0.16, 1, 0.3, 1),
      letter-spacing 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lca:hover .lca-arrow {
    transform: translateX(8px);
    letter-spacing: 0.06em;
  }

  @keyframes lcaWrapIn {
    to { opacity: 1; }
  }
</style>
