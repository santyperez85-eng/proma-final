---
import DotMatrixLayer from './DotMatrixLayer.astro';
import DocumentHeader from './DocumentHeader.astro';
import BadgeV2 from './BadgeV2.astro';
import RegistrationMarksV2 from './RegistrationMarksV2.astro';
import LongArrowCTA from './LongArrowCTA.astro';
---

<section class="hero-v2" data-mode="dark">

  <!-- Background layers — z-index 0 -->
  <DotMatrixLayer />
  <div class="hv2-glow-terra" aria-hidden="true"></div>
  <div class="hv2-glow-purple" aria-hidden="true"></div>

  <!-- Registration marks — packaging DNA -->
  <RegistrationMarksV2 />

  <!-- Main content -->
  <div class="hv2-inner">

    <!-- 1 — Document header band -->
    <div class="hv2-doc-row">
      <DocumentHeader />
    </div>

    <!-- 2 — Title block: dominant center -->
    <div class="hv2-title-block container">
      <h1 class="hv2-title">
        <span class="hv2-line">
          <span class="hv2-word">El proceso</span>
        </span>
        <span class="hv2-line hv2-line-indent">
          <span class="hv2-word">
            <em class="hv2-italic">es</em> el diseño<span class="hv2-dot">.</span>
          </span>
        </span>
      </h1>
    </div>

    <!-- 3 — Bottom info bar -->
    <div class="hv2-bottom container">

      <!-- Left: description -->
      <div class="hv2-desc-col hv2-entrance hv2-entrance--desc">
        <p class="hv2-desc">
          Diseño con método para organizaciones<br />
          que no pueden permitirse el desorden.
        </p>
      </div>

      <!-- Center: badge cluster — campos de estado del sistema -->
      <div class="hv2-badge-col">
        <BadgeV2 text="DOCUMENTED"  variant="active" delay="1.20s" />
        <BadgeV2 text="TRACEABLE"   variant="muted"  delay="1.30s" />
        <BadgeV2 text="CONTROLLED"  variant="muted"  delay="1.40s" />
      </div>

      <!-- Right: CTAs -->
      <div class="hv2-actions-col hv2-entrance hv2-entrance--actions">
        <a href="#contacto" class="btn-cta hv2-cta">Agendá un diagnóstico</a>
        <LongArrowCTA href="#metodo" label="Conocé el método" delay="1.60s" />
      </div>

    </div>
  </div>

  <!-- Scroll hint -->
  <div class="hv2-scroll-hint hv2-entrance hv2-entrance--scroll">
    <span class="hv2-scroll-text type-mono-sm">SCROLL</span>
    <span class="hv2-scroll-line" aria-hidden="true"></span>
  </div>

</section>

<style>
  /* ── Shell ── */
  .hero-v2 {
    position: relative;
    height: 100vh;
    min-height: 600px;
    background-color: var(--proma-navy-900);
    color: var(--proma-cream-100);
    overflow: hidden;
    display: flex;
  }

  /* ── Ambient glows — same depth as v1 ── */
  .hv2-glow-terra {
    position: absolute;
    top: -10%;
    right: -20%;
    width: 80vw;
    height: 80vw;
    background: radial-gradient(
      ellipse at center,
      rgba(212, 82, 26, 0.07) 0%,
      rgba(212, 82, 26, 0.02) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: glowDrift 16s ease-in-out infinite alternate;
  }

  .hv2-glow-purple {
    position: absolute;
    bottom: -30%;
    left: -20%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(
      ellipse at center,
      rgba(120, 80, 200, 0.04) 0%,
      rgba(60, 40, 100, 0.02) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: glowDrift 20s ease-in-out infinite alternate-reverse;
  }

  @keyframes glowDrift {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(40px, -30px) scale(1.05); }
  }

  /* ── Inner layout ── */
  .hv2-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 96px 0 48px;
  }

  /* ── Document header row ── */
  .hv2-doc-row {
    width: 100%;
  }

  /* ── Title block ── */
  .hv2-title-block {
    /* centered in the space between doc header and bottom bar */
  }

  .hv2-title {
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: clamp(52px, 11.5vw, 155px);
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: var(--proma-cream-100);
    text-shadow:
      0 0 80px rgba(242, 237, 228, 0.06),
      0 0 160px rgba(212, 82, 26, 0.04);
  }

  .hv2-line {
    display: block;
    overflow: hidden;
    margin-bottom: -0.12em;
  }

  .hv2-line:last-child {
    margin-bottom: 0;
  }

  .hv2-line-indent {
    padding-left: clamp(40px, 8vw, 120px);
  }

  .hv2-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(105%);
    animation: wordUp 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hv2-line:nth-child(1) .hv2-word { animation-delay: 0.65s; }
  .hv2-line:nth-child(2) .hv2-word { animation-delay: 0.85s; }

  @keyframes wordUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hv2-italic {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--proma-terra-500);
    text-shadow:
      0 0 30px rgba(212, 82, 26, 0.30),
      0 0 60px rgba(212, 82, 26, 0.10);
  }

  .hv2-dot {
    color: var(--proma-terra-500);
  }

  /* ── Bottom bar ── */
  .hv2-bottom {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: end;
    gap: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(242, 237, 228, 0.07);
  }

  /* Description */
  .hv2-desc-col {
    min-width: 0;
  }

  .hv2-desc {
    font-family: var(--font-primary);
    font-size: 14px;
    line-height: 1.7;
    color: var(--proma-cream-100);
    opacity: 0.38;
    max-width: 300px;
  }

  /* Badge cluster */
  .hv2-badge-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-bottom: 2px;
  }

  /* Actions */
  .hv2-actions-col {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .hv2-cta {
    padding: var(--space-3) var(--space-6);
    font-size: 11px;
    opacity: 0;
    animation: hv2Reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.50s forwards;
  }

  /* Generic entrance (description, actions wrapper) */
  .hv2-entrance {
    opacity: 0;
    transform: translateY(16px);
    animation: hv2Reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hv2-entrance--desc    { animation-delay: 1.10s; }
  .hv2-entrance--actions { animation-delay: 1.55s; }
  .hv2-entrance--scroll  { animation-delay: 1.90s; }

  @keyframes hv2Reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Scroll hint ── */
  .hv2-scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(16px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  /* Override the entrance transform for scroll hint since it has its own translate */
  .hv2-entrance--scroll {
    transform: translateX(-50%) translateY(16px);
  }

  @keyframes hv2ScrollReveal {
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .hv2-entrance--scroll {
    animation-name: hv2ScrollReveal;
  }

  .hv2-scroll-text {
    color: var(--proma-cream-100);
    opacity: 0.22;
    font-size: 9px;
    letter-spacing: 0.2em;
  }

  .hv2-scroll-line {
    display: block;
    width: 1px;
    height: 32px;
    background: var(--proma-terra-500);
    transform-origin: top;
    animation: scrollDraw 2s ease-in-out 2.2s infinite;
  }

  @keyframes scrollDraw {
    0%   { transform: scaleY(0); opacity: 0; }
    30%  { transform: scaleY(1); opacity: 0.6; }
    60%  { transform: scaleY(1); opacity: 0; }
    100% { transform: scaleY(0); opacity: 0; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hv2-inner {
      padding: 88px 0 48px;
    }

    .hv2-line-indent {
      padding-left: 0;
    }

    .hv2-bottom {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      align-items: flex-start;
    }

    .hv2-badge-col {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .hv2-actions-col {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .hv2-glow-terra {
      width: 100vw;
      height: 100vw;
      top: 10%;
      right: -30%;
    }
  }
</style>
