<div class="dot-layer" aria-hidden="true"></div>

<style>
  .dot-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: radial-gradient(
      circle,
      rgba(242, 237, 228, 0.07) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    /* Fade en bordes vertical — preserva legibilidad del título central */
    -webkit-mask-image:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0,0,0,0.4) 8%,
        rgba(0,0,0,1) 25%,
        rgba(0,0,0,1) 75%,
        rgba(0,0,0,0.4) 92%,
        transparent 100%
      );
    mask-image:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0,0,0,0.4) 8%,
        rgba(0,0,0,1) 25%,
        rgba(0,0,0,1) 75%,
        rgba(0,0,0,0.4) 92%,
        transparent 100%
      );
    opacity: 0;
    animation: dotLayerReveal 3s ease-out 0.1s forwards;
  }

  @keyframes dotLayerReveal {
    to { opacity: 1; }
  }
</style>
