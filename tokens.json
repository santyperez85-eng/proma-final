{
  "$metadata": {
    "name": "pro.ma Color System v2.0 — Umbral",
    "version": "2.0.0",
    "date": "2026-04-03",
    "description": "Sistema de identidad visual pro.ma Studio. Wordmark: proma (sin punto). La m en Playfair Display Italic es el umbral tipográfico. El punto vive en el sistema de unidades (pro.pack, pro.brand, pro.web, pro.ops)."
  },

  "color": {
    "primitive": {
      "navy-900": { "value": "#0A0A0F", "description": "Near-black — fondo principal modo oscuro" },
      "navy-800": { "value": "#111118", "description": "Surface elevada oscura" },
      "navy-700": { "value": "#1A1A24", "description": "Bordes y superficies oscuras" },
      "terra-500": { "value": "#D4521A", "description": "Acento terracota principal — punto del sistema de unidades" },
      "terra-700": { "value": "#B5420F", "description": "Acento oscuro — hover/pressed states" },
      "cream-50":  { "value": "#FAF8F4", "description": "Fondo principal modo claro" },
      "cream-100": { "value": "#F2EDE4", "description": "Texto principal sobre fondos oscuros" },
      "cream-200": { "value": "#EAE6DE", "description": "Surface modo claro / borde claro" },
      "text-dark":  { "value": "#2C2420", "description": "Texto principal sobre fondos claros" }
    },
    "semantic": {
      "dark": {
        "bg":           { "value": "{color.primitive.navy-900}",  "hex": "#0A0A0F" },
        "surface":      { "value": "{color.primitive.navy-700}",  "hex": "#1A1A24" },
        "accent":       { "value": "{color.primitive.terra-500}", "hex": "#D4521A" },
        "accent-hover": { "value": "{color.primitive.terra-700}", "hex": "#B5420F" },
        "text-primary": { "value": "{color.primitive.cream-100}", "hex": "#F2EDE4" },
        "text-accent":  { "value": "{color.primitive.terra-500}", "hex": "#D4521A" },
        "border":       { "value": "{color.primitive.navy-700}",  "hex": "#1A1A24" }
      },
      "light": {
        "bg":           { "value": "{color.primitive.cream-50}",  "hex": "#FAF8F4" },
        "surface":      { "value": "{color.primitive.cream-200}", "hex": "#EAE6DE" },
        "accent":       { "value": "{color.primitive.terra-500}", "hex": "#D4521A" },
        "accent-hover": { "value": "{color.primitive.terra-700}", "hex": "#B5420F" },
        "text-primary": { "value": "{color.primitive.text-dark}", "hex": "#2C2420" },
        "text-accent":  { "value": "{color.primitive.terra-500}", "hex": "#D4521A" },
        "border":       { "value": "{color.primitive.cream-200}", "hex": "#EAE6DE" }
      }
    },
    "rgba": {
      "glow-terra-soft":   { "value": "rgba(212, 82, 26, 0.05)",  "use": "Glow ambiental terracota — fondos oscuros" },
      "glow-terra-medium": { "value": "rgba(212, 82, 26, 0.08)",  "use": "Glow ambiental terracota — variante más intensa" },
      "glow-purple":       { "value": "rgba(120, 80, 200, 0.03)", "use": "Glow púrpura secundario — profundidad" },
      "border-dark-soft":  { "value": "rgba(242, 237, 228, 0.06)", "use": "Bordes sutiles en fondos oscuros" },
      "border-dark-med":   { "value": "rgba(242, 237, 228, 0.1)",  "use": "Bordes medios en fondos oscuros" },
      "glassmorphism-bg":  { "value": "rgba(255, 255, 255, 0.03)", "use": "Cards con glassmorphism (trabajo)" },
      "nav-scrolled":      { "value": "rgba(10, 10, 15, 0.9)",    "use": "Nav en estado scrolled" }
    }
  },

  "typography": {
    "fontFamily": {
      "wordmark":        { "value": "'Grantha Sangam MN', Georgia, serif",     "description": "Wordmark — caracteres p, r, o, a. Solo para el wordmark proma." },
      "wordmark-accent": { "value": "'Playfair Display', Georgia, serif",       "description": "Wordmark m (italic) + acentos tipográficos en títulos clave. El umbral tipográfico." },
      "primary":         { "value": "'Plus Jakarta Sans', sans-serif",          "description": "Todo el sistema — títulos, cuerpo, UI, navegación, botones." },
      "mono":            { "value": "'IBM Plex Mono', monospace",               "description": "Trazabilidad técnica — refs, versiones, marcadores numéricos, sufijos de unidades." }
    },
    "fontWeight": {
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" },
      "bold":     { "value": "700" }
    },
    "scale": {
      "t1":       { "size": "36px",  "weight": "700", "family": "primary", "tracking": "-0.04em", "lineHeight": "1.15" },
      "t2":       { "size": "28px",  "weight": "600", "family": "primary", "tracking": "-0.02em", "lineHeight": "1.2"  },
      "t3":       { "size": "22px",  "weight": "600", "family": "primary", "tracking": "0",       "lineHeight": "1.3"  },
      "t4":       { "size": "18px",  "weight": "500", "family": "primary", "tracking": "0",       "lineHeight": "1.4"  },
      "body":     { "size": "14px",  "weight": "400", "family": "primary", "tracking": "0",       "lineHeight": "1.6"  },
      "small":    { "size": "12px",  "weight": "400", "family": "primary", "tracking": "0",       "lineHeight": "1.5"  },
      "label-ui": { "size": "11px",  "weight": "500", "family": "primary", "tracking": "0.08em",  "lineHeight": "1",   "transform": "uppercase" },
      "mono-lg":  { "size": "15px",  "weight": "400", "family": "mono",    "tracking": "0.06em",  "lineHeight": "1.4"  },
      "mono-md":  { "size": "12px",  "weight": "400", "family": "mono",    "tracking": "0.04em",  "lineHeight": "1.4"  },
      "mono-sm":  { "size": "11px",  "weight": "400", "family": "mono",    "tracking": "0.02em",  "lineHeight": "1.4"  }
    },
    "dynamic": {
      "hero-title":          { "clamp": "clamp(52px, 11.5vw, 155px)", "weight": "700", "tracking": "-0.05em" },
      "section-title":       { "clamp": "clamp(40px, 6vw, 80px)",     "weight": "700", "tracking": "-0.04em" },
      "problema-lead":       { "clamp": "clamp(28px, 4vw, 52px)",     "weight": "700", "tracking": "-0.03em" },
      "problema-conclusion": { "clamp": "clamp(32px, 5vw, 64px)",     "weight": "700", "tracking": "-0.04em" },
      "servicios-nombre":    { "clamp": "clamp(22px, 3vw, 36px)",     "weight": "600", "tracking": "-0.02em" },
      "proma4-display":      { "clamp": "clamp(48px, 7vw, 100px)",    "weight": "400", "family": "mono", "tracking": "+0.02em" },
      "contacto-title":      { "clamp": "clamp(28px, 3.5vw, 44px)",   "weight": "700", "tracking": "-0.03em" }
    },
    "playfair-italic-glow": {
      "description": "Text-shadow aplicado a todas las palabras en Playfair Display Italic + color terra-500",
      "value": "0 0 30px rgba(212, 82, 26, 0.25), 0 0 60px rgba(212, 82, 26, 0.08)"
    }
  },

  "wordmark": {
    "name": "proma",
    "note": "Sin punto. La m en Playfair Display Italic es el umbral tipográfico.",
    "structure": {
      "p": { "font": "Grantha Sangam MN", "style": "Regular" },
      "r": { "font": "Grantha Sangam MN", "style": "Regular" },
      "o": { "font": "Grantha Sangam MN", "style": "Regular" },
      "m": { "font": "Playfair Display",  "style": "Italic",  "note": "Umbral tipográfico — no colorear con acento. Siempre monocromático." },
      "a": { "font": "Grantha Sangam MN", "style": "Regular" }
    },
    "color": {
      "dark-mode":  { "text": "#F2EDE4", "bg": "#0A0A0F" },
      "light-mode": { "text": "#2C2420", "bg": "#FAF8F4" }
    },
    "rule": "Siempre monocromático. El acento #D4521A NO aparece en el wordmark.",
    "reduced": {
      "characters": "pm",
      "use": "32px o menos — favicon, avatar, aplicaciones pequeñas"
    },
    "assets": {
      "dark":    "/public/brand/proma-wordmark-dark.svg",
      "light":   "/public/brand/proma-wordmark-light.svg",
      "favicon": "/public/brand/proma-favicon.svg"
    }
  },

  "unitSystem": {
    "description": "El punto vive en el sistema de nomenclatura de unidades, no en el wordmark principal.",
    "dot": { "color": "#D4521A", "font": "Grantha Sangam MN", "note": "Aquí vive el acento terracota" },
    "suffix-font": "IBM Plex Mono",
    "units": [
      { "name": "pro.pack",  "description": "Packaging gráfico, estructural, regulatorio" },
      { "name": "pro.brand", "description": "Branding e identidad visual" },
      { "name": "pro.web",   "description": "Web y aplicaciones" },
      { "name": "pro.ops",   "description": "DesignOps y mantenimiento" }
    ],
    "rule": "Las unidades NO tienen logo propio. Su identidad es la lógica de nomenclatura."
  },

  "spacing": {
    "base": "4px",
    "scale": {
      "1": "4px", "2": "8px", "3": "12px", "4": "16px",
      "5": "20px", "6": "24px", "8": "32px", "10": "40px",
      "12": "48px", "16": "64px", "20": "80px", "24": "96px"
    },
    "layout": {
      "container-max": "1200px",
      "container-padding": "24px",
      "section-desktop": "120px",
      "section-mobile": "80px"
    }
  },

  "borderRadius": {
    "sm": "3px", "md": "6px", "lg": "12px", "pill": "999px",
    "note": "Cards de trabajo: sin border-radius (esquinas rectas). No usar border-radius en elementos de diseño principales."
  },

  "animation": {
    "easing": {
      "main": "cubic-bezier(0.16, 1, 0.3, 1)",
      "note": "Easing universal del sistema — elástico pero controlado"
    },
    "durations": {
      "fast": "0.15s",
      "normal": "0.3s",
      "medium": "0.4s",
      "slow": "0.7s",
      "hero": "1.2s"
    },
    "scrollReveal": {
      "translate": "translateY(32px) → 0",
      "opacity": "0 → 1",
      "duration": "0.7s",
      "threshold": "0.15"
    }
  },

  "mode": {
    "dark": {
      "signal": "Impacto · Autoridad · Presentación",
      "use": ["Hero", "El problema", "Estudio", "Trabajo preview", "Contacto", "Footer", "/servicios", "/trabajo/[slug]", "Portadas", "Pitch decks", "Brand decks"]
    },
    "light": {
      "signal": "Lectura · Proceso · Documentación",
      "use": ["Servicios accordion (home)", "Método PROMA-4", "Informes", "Manuales", "Documentación"]
    },
    "rule": "La elección de modo es una decisión de diseño, no del usuario. El acento #D4521A es constante en ambos modos. El wordmark es siempre monocromático."
  }
}
